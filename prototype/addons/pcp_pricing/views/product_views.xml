<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_category_form_view" model="ir.ui.view">
        <field name="name">product.category.form.pcp_pricing</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group name="category_margins" string="Márgenes del rubro">
                    <field name="wholesale_margin" />
                    <field name="retail_margin" />
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.pcp_pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="group_standard_price" position="inside">
                <field name="replacement_cost" invisible="type == 'combo' or product_variant_count &gt; 1" />
                <field name="pack_size" invisible="type == 'combo' or product_variant_count &gt; 1" />
            </group>
        </field>
    </record>

    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.easy.form.pcp_pricing</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="replacement_cost" />
                <field name="pack_size" />
            </field>
        </field>
    </record>

    <record id="product_pricelist_view" model="ir.ui.view">
        <field name="name">product.pricelist.form.pcp_pricing</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view" />
        <field name="arch" type="xml">
            <group name="pricelist_settings" position="inside">
                <field name="list_kind" />
            </group>
        </field>
    </record>
</odoo>
