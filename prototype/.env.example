# Copy to .env for the local dev copy (values below work as-is after ./dev-pull.sh),
# or to .env.deployed and fill in the Coolify instance's values.
ODOO_URL=http://localhost:8069
ODOO_DB=proto
ODOO_ADMIN_LOGIN=admin
# dev-pull.sh resets the local admin password to this value.
ODOO_ADMIN_PASSWORD=admin
# Odoo master password: ADMIN_PASSWD in docker-compose.dev.yaml (local) or in Coolify (deployed).
ODOO_MASTER_PASSWORD=dev
# Optional. setup-proto.py keeps the company's current CUIT when unset.
# COMPANY_CUIT=
